#!/usr/bin/env bash
# Usage: blacklight-query [options] [urls.txt | -]   (see --help)
# All argument handling, including reading piped stdin, is in src/main.ts.

set -o errexit
set -o pipefail
set -o nounset

dir=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

exec "$dir/node_modules/.bin/ts-node" --project "$dir/tsconfig.json" "$dir/src/main.ts" "$@"
