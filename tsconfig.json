{
    "ts-node": {
      // these options are overrides used only by ts-node
      // same as the --compilerOptions flag and the TS_NODE_COMPILER_OPTIONS environment variable
      "compilerOptions": {
        "module": "commonjs"
      }
    },
    "compilerOptions": {
      "module": "nodenext",
      // Explicit, so ts-node (which overrides module) doesn't fall back to ES5,
      // where `instanceof` fails for Error subclasses.
      "target": "es2022"
    }
  }
